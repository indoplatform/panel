# ============================================================
# Indoplatform Panel — Environment variables
# Copy file ini ke .env dan isi nilainya.
# JANGAN commit file .env ke git (.gitignore).
# ============================================================

# --- Database (PostgreSQL) -----------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/panel?schema=public"

# --- NextAuth -----------------------------------------------
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-random-base64-32-bytes"
NEXTAUTH_URL="http://localhost:3003"

# --- Panel config -------------------------------------------
# Subdomain publik (untuk reverse proxy & branding)
PANEL_HOSTNAME="panel.local"

# Path SSH key (untuk remote exec systemctl jika Panel tidak di VPS yang sama)
SSH_KEY_PATH="/root/.ssh/id_rsa"
SSH_USER="root"
SSH_HOST="127.0.0.1"
SSH_PORT="22"

# Cloudflare API (untuk DNS manager)
# Scope: Zone:DNS:Edit + Zone:Zone:Read di zone yang Anda kelola
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# Email alert (opsional — Brevo SMTP)
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER=""
BREVO_SMTP_PASS=""
BREVO_FROM_EMAIL="panel@example.com"
BREVO_FROM_NAME="Indoplatform Panel"

# Notifikasi Telegram (opsional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Thresholds alert
ALERT_CPU_THRESHOLD="85"
ALERT_MEMORY_THRESHOLD="90"
ALERT_DISK_THRESHOLD="90"
